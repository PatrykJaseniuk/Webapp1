{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@/backend": ["./src/volatile0/infra"],
      "@/backend/*": ["./src/volatile0/infra/*"],
      "@/domain": ["./src/volatile0/domain"],
      "@/domain/*": ["./src/volatile0/domain/*"],
      "@/shared": ["./src/volatile0/generic"],
      "@/shared/*": ["./src/volatile0/generic/*"],
      "@/routes": ["./src/volatile1/routes"],
      "@/routes/*": ["./src/volatile1/routes/*"],
      "@/auth": ["./src/volatile1/auth"],
      "@/auth/*": ["./src/volatile1/auth/*"],
      "@/features/*": ["./src/volatile2/*"],
      "@/pages/*": ["./src/volatile2/pages/*"],
      "@/layout": ["./src/volatile2/layout"],
      "@/layout/*": ["./src/volatile2/layout/*"],
      "@/app": ["./src/volatile2/app"],
      "@/app/*": ["./src/volatile2/app/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}